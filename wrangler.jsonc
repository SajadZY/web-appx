{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appx",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2f0e3208-ebdb-4c80-a6ff-96c17a7fa3e4","database_name": "web-appx" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "266024284e8b4ee4b78d79550b796893" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
